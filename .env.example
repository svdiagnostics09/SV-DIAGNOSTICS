# Copy this file to `.env.local` and fill it in. `.env.local` is git-ignored.
#
# Neon console -> your project -> Dashboard -> Connect -> "Connection string".
# Use the POOLED string (the host ends in `-pooler`), e.g.:
#   DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# The app also accepts the password-only string Neon shows in some views.
# If your password contains @ : / ? # or %, URL-encode it (e.g. @ -> %40).
DATABASE_URL=

# --- Administrator bootstrap (used once by `npm run db:migrate`) -------------
# No default password exists. At least 10 characters. There is no public sign-up.
ADMIN_EMAIL=owner@example.com
ADMIN_NAME=SVadmin
ADMIN_PASSWORD=admin@1234

# --- Payments ----------------------------------------------------------------
# There is no online payment. Patients pay the collector at home or at the
# laboratory reception, so no payment gateway credentials are needed.

# --- Email (optional; notifications recorded as "skipped" until configured) --
RESEND_API_KEY=
EMAIL_FROM="SV Diagnostics <bookings@your-domain.in>"
STAFF_EMAIL=

# --- WhatsApp (manual sending — no API credentials needed) -------------------
# Reports are sent by hand: "Send on WhatsApp" opens the patient's wa.me chat in
# a new tab, and the administrator attaches the uploaded PDF and presses send.
# These variables are only needed if you later switch back to API sending.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
# Only for Meta's "test number" sandbox, which accepts a single fixed sample template.
WHATSAPP_TEMPLATE_E2E_ID=
# Pin the Graph API version if your app targets an older one (default v23.0).
WHATSAPP_API_VERSION=

# Public site origin — used for absolute links in emails.
NEXT_PUBLIC_SITE_URL=

# --- Misc --------------------------------------------------------------------
IP_HASH_SALT=change-me
# DATABASE_POOL_SIZE=5
