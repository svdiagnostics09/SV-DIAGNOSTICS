# Copy this file to `.env.local` and fill in your Neon connection string.
# .env.local is git-ignored and is loaded automatically by `next dev`.
#
# Neon console -> your project -> Dashboard -> Connect -> "Connection string".
# Use the POOLED string (the host ends in `-pooler`), e.g.:
#   DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
#
# If your password contains @ : / ? # or %, URL-encode it (e.g. @ -> %40).
DATABASE_URL=

# Optional: replace the default admin credentials (defaults: admin / sv-admin-2026).
# ADMIN_ID=admin
# ADMIN_PASSWORD=change-me
