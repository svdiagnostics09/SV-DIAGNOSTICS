# Copy this file to `.env.local` and fill it in. `.env.local` is git-ignored.
#
# Neon console -> your project -> Dashboard -> Connect -> "Connection string".
# Use the POOLED string (the host ends in `-pooler`), e.g.:
#   DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# The app also accepts the password-only string Neon shows in some views.
# If your password contains @ : / ? # or %, URL-encode it (e.g. @ -> %40).
DATABASE_URL=

# --- Administrator bootstrap (used once by `npm run db:migrate`) -------------
# No default password exists. At least 10 characters. There is no public sign-up.
ADMIN_EMAIL=owner@example.com
ADMIN_NAME=SVadmin
ADMIN_PASSWORD=admin@1234

# --- Payments (optional; online payment is hidden until configured) ---------
# Razorpay dashboard -> Account & Settings -> API keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay dashboard -> Webhooks -> secret. Endpoint: https://your-domain/api/payments/webhook
RAZORPAY_WEBHOOK_SECRET=

# --- Email (optional; notifications recorded as "skipped" until configured) --
RESEND_API_KEY=
EMAIL_FROM="SV Diagnostics <bookings@your-domain.in>"
STAFF_EMAIL=

# --- WhatsApp (Meta Cloud API) — admin sends report PDFs to patients ----------
# Meta for Developers -> your app -> WhatsApp -> API Setup. The temporary token
# expires after 24h; create a System User token for production.
# WHATSAPP_PHONE_NUMBER_ID is the numeric "Phone number ID" (not the display number).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional: pin the template (overrides the name set in Business settings).
# The default template `patient_report` takes 3 body parameters in this order:
#   {{1}} patient name   {{2}} booking reference   {{3}} report download link
WHATSAPP_TEMPLATE_NAME=
# Only for Meta's "test number" sandbox, which accepts a single fixed sample template.
WHATSAPP_TEMPLATE_E2E_ID=
# Pin the Graph API version if your app targets an older one (default v23.0).
WHATSAPP_API_VERSION=

# Public URL used in the WhatsApp report link. Set it on the host (e.g. Vercel)
# so links are absolute even behind a proxy; falls back to the request origin.
NEXT_PUBLIC_SITE_URL=

# --- Misc --------------------------------------------------------------------
IP_HASH_SALT=change-me
# DATABASE_POOL_SIZE=5
